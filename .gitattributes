# Store and check out text files with LF line endings on every operating system,
# so that files (and the registry hashes recorded in fit results) are byte-identical
# on Linux, macOS and Windows. PowerShell scripts keep CRLF, which Windows tools expect.
* text=auto eol=lf
*.ps1 text eol=crlf

# Binary files: never convert.
*.png binary
*.npz binary
